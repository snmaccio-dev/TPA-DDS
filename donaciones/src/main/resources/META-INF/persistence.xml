<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <!-- Unidad de persistencia para Donaciones -->
    <persistence-unit name="simple-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>donatrack.donaciones.domain.persona.Persona</class>
        <class>donatrack.donaciones.domain.persona.PersonaHumana</class>
        <class>donatrack.donaciones.domain.persona.PersonaJuridica</class>
        <class>donatrack.donaciones.domain.persona.Donante</class>
        <class>donatrack.donaciones.domain.persona.Beneficiaria</class>
        <class>donatrack.donaciones.domain.contacto.MedioContacto</class>
        <!--
          Usuario ya no es una fila de credenciales: ahora representa el vinculo
          entre una cuenta de Keycloak (por su "sub") y un perfil local.
        -->
        <class>donatrack.donaciones.domain.usuario.Usuario</class>
        <class>donatrack.donaciones.domain.catalogo.Categoria</class>
        <class>donatrack.donaciones.domain.catalogo.Subcategoria</class>
        <class>donatrack.donaciones.domain.donacion.Donacion</class>
        <class>donatrack.donaciones.domain.donacion.Bien</class>
        <class>donatrack.donaciones.domain.donacion.estado.EstadoDonacion</class>
        <class>donatrack.donaciones.domain.donacion.estado.EstadoEntregaFallida</class>
        <class>donatrack.donaciones.domain.donacion.asignacion.PropuestaAsignacion</class>
        <class>donatrack.donaciones.domain.necesidad.Necesidad</class>
        <class>donatrack.donaciones.domain.necesidad.NecesidadRecurrente</class>
        <class>donatrack.donaciones.domain.necesidad.NecesidadExtraordinaria</class>

        <properties>
            <!-- Conexión a PostgreSQL para despliegue local -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="javax.persistence.jdbc.url" value="${db.url}" />
            <property name="javax.persistence.jdbc.user" value="${db.user}" />
            <property name="javax.persistence.jdbc.password" value="${db.password}" />

            <!-- Configuración de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL10Dialect" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>
