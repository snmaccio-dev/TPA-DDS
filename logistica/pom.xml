<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>donatrack</groupId>
        <artifactId>donatrack-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logistica</artifactId>

    <properties>
        <javalin.version>6.4.0</javalin.version>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <nimbus.version>9.37.3</nimbus.version>
        <graphql.version>21.3</graphql.version>
        <db.url>jdbc:postgresql://localhost:5432/donatrack_logistica</db.url>
        <db.user>postgres</db.user>
        <db.password>${env.DONATRACK_DB_PASSWORD}</db.password>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!--
          Javalin resuelve el JSON del lado servidor, pero no expone un serializador para las
          llamadas salientes hacia Donaciones y hacia el planificador externo. Se declara el
          mismo Jackson que Javalin ya trae, en vez de sumar una segunda libreria de JSON.
          Su uso esta confinado a SerializadorJackson, detras del puerto SerializadorJson.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!--
          Validacion y parsing de JWT contra el JWKS de Keycloak (RS256). Misma version
          que declara Donaciones: los dos servicios validan tokens del mismo realm, asi
          que conviene que lo hagan con la misma implementacion.
        -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus.version}</version>
        </dependency>

        <!--
          Motor GraphQL. Resuelve el esquema y las consultas; el transporte sigue siendo
          Javalin, asi que no suma ni un servidor ni un puerto nuevo.
        -->
        <dependency>
            <groupId>com.graphql-java</groupId>
            <artifactId>graphql-java</artifactId>
            <version>${graphql.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>donatrack.logistica.LogisticaApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
