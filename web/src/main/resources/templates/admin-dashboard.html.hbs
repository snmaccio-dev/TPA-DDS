{{> templates/partials/head}}
<body data-page="admin-dashboard" data-role="admin">
    {{> templates/partials/sidebar}}
    {{> templates/partials/topbar}}
    <main class="app-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">RESUMEN GENERAL</span>
                <h1>Panel de administración</h1>
                <p>Monitoreá la operación general de DonaTrack.</p>
            </div>
            <span class="date-chip">◷ {{fechaActual}}</span>
        </div>
        <div class="metric-grid">
            <article class="metric-card">
                <span class="metric-icon green">▧</span>
                <strong>{{#if datosDonacionesDisponibles}}{{totalDonaciones}}{{else}}—{{/if}}</strong>
                <span>Donaciones registradas</span>
                <small>{{#if datosDonacionesDisponibles}}Total de donaciones{{else}}No disponible{{/if}}</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon blue">▧</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesEnDeposito}}{{else}}—{{/if}}</strong>
                <span>Pendientes de asignación</span>
                <small>{{#if datosDonacionesDisponibles}}Donaciones en depósito{{else}}No disponible{{/if}}</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon amber">▧</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesEnTraslado}}{{else}}—{{/if}}</strong>
                <span>En traslado</span>
                <small>{{#if datosDonacionesDisponibles}}Donaciones en camino{{else}}No disponible{{/if}}</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon lavender">▧</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesEntregadas}}{{else}}—{{/if}}</strong>
                <span>Entregas confirmadas</span>
                <small>{{#if datosDonacionesDisponibles}}Donaciones entregadas{{else}}No disponible{{/if}}</small>
            </article>
        </div>
        <div class="dashboard-grid">
            <section class="panel">
                <div class="panel-head">
                    <div>
                        <h3>Actividad reciente</h3>
                        <small>Últimas donaciones registradas</small>
                    </div>
                    <a href="/deposito">Ver todos →</a>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Donación</th>
                                <th>Fecha de entrega</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                            <tbody>
                                {{#if datosDonacionesDisponibles}}
                                    {{#each donacionesRecientes}}
                                        <tr>
                                            <td><a href="/deposito">#{{id}} · {{descripcion}}</a></td>
                                            <td>{{#if fechaHoraEntregaTexto}}{{fechaHoraEntregaTexto}}{{else}}—{{/if}}</td>
                                            <td><span class="status-pill {{estadoClase}}">{{estadoTexto}}</span></td>
                                        </tr>
                                    {{else}}
                                        <tr>
                                            <td colspan="3" class="muted">Todavía no hay donaciones registradas.</td>
                                        </tr>
                                    {{/each}}
                                {{else}}
                                    <tr>
                                        <td colspan="3" class="muted">No disponible. No se pudo cargar la actividad reciente.</td>
                                    </tr>
                                {{/if}}
                            </tbody>
                    </table>
                </div>
            </section>
            <section class="panel quick-panel">
                <div class="panel-head">
                    <h3>Accesos rápidos</h3>
                </div>
                <a class="quick-link" href="/deposito">
                    <span>Registrar ingreso</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/asignaciones">
                    <span>Asignar donación</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/importar-csv">
                    <span>Importar donantes</span>
                    <b>→</b>
                </a>
            </section>
        </div>
    </main>
    {{> templates/partials/footer}}
    {{> templates/partials/scripts}}
