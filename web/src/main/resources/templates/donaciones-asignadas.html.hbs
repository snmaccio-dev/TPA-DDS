{{> templates/partials/head}}
<body data-page="assigned" data-role="beneficiario">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">RECEPCIONES</span>
            <h1>Donaciones asignadas</h1>
            <p>Consultá las donaciones destinadas a tu organización.</p>
        </div>
    </div>
    <section class="panel">
        <div class="panel-head">
            <h3>Donaciones recibidas o en curso</h3>
            <span class="muted">{{donaciones.size}} registradas</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Donación</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                        <th>Fecha de entrega</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each donaciones}}
                    <tr>
                        <td>{{descripcion}}</td>
                        <td>{{cantidadTexto}}</td>
                        <td><span class="status-pill {{estadoClase}}">{{estadoTexto}}</span></td>
                        <td>{{fechaHoraEntregaTexto}}</td>
                    </tr>
                    {{/each}}
                    {{#unless donaciones}}
                    <tr><td colspan="4" class="muted">Todavía no hay donaciones asignadas.</td></tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </section>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
