{{> templates/partials/head}}
<body data-page="my-donations" data-role="donante">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}

<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">HISTORIAL</span>
            <h1>Mis donaciones</h1>
            <p>Consultá tus aportes y filtrá por estado o tipo de bien.</p>
        </div>
    </div>

    <section class="panel">

        <form class="filter-bar" method="get" action="/mis-donaciones">

            <label>Estado
                <select name="estado">
                    <option value="">Todos los estados</option>
                    <option value="EN_DEPOSITO">En depósito</option>
                    <option value="ASIGNACION_REALIZADA">Asignada</option>
                    <option value="LISTA_PARA_ENTREGAR">Lista para entregar</option>
                    <option value="EN_TRASLADO">En traslado</option>
                    <option value="ENTREGADA">Entregada</option>
                    <option value="ENTREGA_FALLIDA">Entrega fallida</option>
                    <option value="VENCIDA">Vencida</option>
                </select>
            </label>

            <label>Categoría
                <input
                    type="search"
                    id="busquedaCategoria"
                    name="categoria"
                    value="{{filtro.categoria}}"
                    placeholder="Escribí para buscar una categoría..."
                    list="listaCategorias"
                    autocomplete="off">
                
                <datalist id="listaCategorias">
                    {{#each categorias}}
                    <option value="{{this}}"></option>
                    {{/each}}
                </datalist>
            </label>

            <label>Subcategoría
                <input
                    type="search"
                    id="busquedaSubcategoria"
                    name="subcategoria"
                    value="{{filtro.subcategoria}}"
                    placeholder="Primero seleccioná una categoría..."
                    list="listaSubcategorias"
                    autocomplete="off"
                    disabled>

                <datalist id="datosSubcategorias">
                    {{#each subcategorias}}
                    <option
                        value="{{nombre}}"
                        data-categoria="{{categoria}}"
                        label="{{etiqueta}}">
                    </option>
                    {{/each}}
                </datalist>

                <datalist id="listaSubcategorias"></datalist>

                <small class="muted" id="ayudaSubcategoria">
                    Primero seleccioná una categoría.
                </small>
            </label>

            <button class="btn btn-primary" type="submit">Buscar</button>
            <a class="btn btn-secondary" href="/mis-donaciones">Limpiar</a>

        </form>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Donación</th>
                        <th>Categoría</th>
                        <th>Subcategoría</th>
                        <th>Entidad</th>
                        <th>Fecha entrega</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each donaciones}}
                    <tr>
                        <td>{{descripcion}}</td>
                        <td>{{categoria}}</td>
                        <td>{{subcategoria}}</td>
                        <td>{{razonSocialBeneficiaria}}</td>
                        <td>{{fechaHoraEntregaTexto}}</td>
                        <td>{{cantidadTexto}}</td>
                        <td>
                            <span class="status-pill {{estadoClase}}">
                                {{estadoTexto}}
                            </span>
                        </td>
                    </tr>
                    {{/each}}

                    {{#unless donaciones}}
                    <tr>
                        <td colspan="7" class="muted">
                            No hay donaciones para mostrar.
                        </td>
                    </tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>

    </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const categoria = document.getElementById("busquedaCategoria");
    const subcategoria = document.getElementById("busquedaSubcategoria");

    const listaCategorias = document.getElementById("listaCategorias");
    const listaSubcategorias = document.getElementById("listaSubcategorias");
    const datosSubcategorias = document.getElementById("datosSubcategorias");

    const ayuda = document.getElementById("ayudaSubcategoria");

    const categoriasDisponibles = Array.from(listaCategorias.options)
        .map(opcion => opcion.value.trim().toLowerCase());

    const subcategoriasDisponibles = Array.from(datosSubcategorias.options);

    function actualizarSubcategorias(limpiarSeleccion = true) {
        const categoriaElegida = categoria.value.trim().toLowerCase();

        const categoriaValida = categoriasDisponibles.includes(categoriaElegida);

        listaSubcategorias.replaceChildren();

        if (limpiarSeleccion) {
            subcategoria.value = "";
        }

        if (!categoriaValida) {
            subcategoria.disabled = true;
            subcategoria.placeholder = "Primero seleccioná una categoría...";
            ayuda.textContent = "Seleccioná una categoría válida.";
            return;
        }

        const disponibles = subcategoriasDisponibles.filter(opcion =>
            (opcion.dataset.categoria || "").trim().toLowerCase() === categoriaElegida
        );

        disponibles.forEach(opcion => {
            const nuevaOpcion = document.createElement("option");
            nuevaOpcion.value = opcion.value;
            nuevaOpcion.label = opcion.label;
            listaSubcategorias.appendChild(nuevaOpcion);
        });

        subcategoria.disabled = disponibles.length === 0;
        subcategoria.placeholder = disponibles.length > 0
            ? "Escribí para buscar una subcategoría..."
            : "No hay subcategorías disponibles";

        ayuda.textContent = disponibles.length > 0
            ? "Buscá una subcategoría perteneciente a la categoría seleccionada."
            : "No hay subcategorías para esta categoría.";
    }

    categoria.addEventListener("input", () => {
        categoria.setCustomValidity("");
        actualizarSubcategorias(true);
    });

    categoria.addEventListener("change", () => {
        actualizarSubcategorias(true);
    });

    subcategoria.addEventListener("input", () => {
        subcategoria.setCustomValidity("");
    });

    // Recuperar las sugerencias al volver de una búsqueda.
    if (categoria.value.trim() !== "") {
        actualizarSubcategorias(false);
    }

    // Validar que los filtros correspondan a opciones disponibles.
    categoria.form.addEventListener("submit", event => {
        const categoriaElegida = categoria.value.trim().toLowerCase();

        if (categoriaElegida !== "" &&
            !categoriasDisponibles.includes(categoriaElegida)) {
            event.preventDefault();
            categoria.setCustomValidity("Seleccioná una categoría de la lista.");
            categoria.reportValidity();
            return;
        }

        const subcategoriaElegida = subcategoria.value.trim().toLowerCase();

        if (subcategoriaElegida !== "") {
            const subcategoriaValida = Array.from(listaSubcategorias.options).some(opcion =>
                opcion.value.trim().toLowerCase() === subcategoriaElegida
            );

            if (!subcategoriaValida) {
                event.preventDefault();
                subcategoria.setCustomValidity(
                    "Seleccioná una subcategoría de la categoría elegida."
                );
                subcategoria.reportValidity();
            }
        }
    });
});
</script>

{{> templates/partials/footer}}
{{> templates/partials/scripts}}
</body>