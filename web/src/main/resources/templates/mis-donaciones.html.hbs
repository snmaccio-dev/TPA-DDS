{{> templates/partials/head}}
<body data-page="my-donations" data-role="donante">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
<div class="page-heading">
    <div>
        <span class="eyebrow">HISTORIAL</span>
        <h1>Mis donaciones</h1>
        <p>Consultá tus aportes y filtrá por estado o tipo de bien.</p>
    </div>
</div>
<section class="panel">
    <form class="filter-bar" method="get" action="/mis-donaciones">
        <label>Estado
            <select name="estado">
                <option value="">Todos los estados</option>
                <option value="EN_DEPOSITO">En depósito</option>
                <option value="ASIGNACION_REALIZADA">Asignada</option>
                <option value="LISTA_PARA_ENTREGAR">Lista para entregar</option>
                <option value="EN_TRASLADO">En traslado</option>
                <option value="ENTREGADA">Entregada</option>
                <option value="ENTREGA_FALLIDA">Entrega fallida</option>
                <option value="VENCIDA">Vencida</option>
            </select>
        </label>
        <label>Categoría
            <select name="categoria">
                <option value="">Todas las categorías</option>
                {{#each categorias}}
                <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </label>
        <label>Subcategoría
            <select name="subcategoria">
                <option value="">Todas las subcategorías</option>
                {{#each subcategorias}}
                <option value="{{nombre}}">{{etiqueta}}</option>
                {{/each}}
            </select>
        </label>
        <button class="btn btn-primary" type="submit">Filtrar</button>
    </form>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Donación</th>
                    <th>Categoría</th>
                    <th>Subcategoría</th>
                    <th>Entidad</th>
                    <th>Fecha entrega</th>
                    <th>Cantidad</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                {{#each donaciones}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td>{{categoria}}</td>
                    <td>{{subcategoria}}</td>
                    <td>{{razonSocialBeneficiaria}}</td>
                    <td>{{fechaHoraEntregaTexto}}</td>
                    <td>{{cantidadTexto}}</td>
                    <td><span class="status-pill {{estadoClase}}">{{estadoTexto}}</span></td>
                </tr>
                {{/each}}
                {{#unless donaciones}}
                <tr><td colspan="7" class="muted">No hay donaciones para mostrar.</td></tr>
                {{/unless}}
            </tbody>
        </table>
    </div>
</section>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
