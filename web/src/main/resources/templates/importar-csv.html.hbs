{{> templates/partials/head}}
<body data-page="csv-import" data-role="admin">
    {{> templates/partials/sidebar}}
    {{> templates/partials/topbar}}
    <main class="app-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">CARGA MASIVA</span>
                <h1>Importar donantes desde CSV</h1>
                <p>Importá donantes existentes para otorgarles un usuario en DonaTrack.</p>
            </div>
        </div>
        <div class="csv-layout">
            <form class="panel form-panel" id="csv-form" method="post" action="/importar-csv"
                  enctype="multipart/form-data">
                <h3>Archivo de importación</h3>
                <label class="upload-box large-upload">
                    <span class="upload-symbol">⇧</span>
                    <b>Arrastrá tu archivo CSV o seleccioná uno</b>
                    <small>Formato .csv · Más de 10.000 filas admitidas</small>
                    <input type="file" name="archivo" accept=".csv,text/csv" id="csv-file">
                </label>
                <div class="csv-requirements">
                    <b>Columnas esperadas</b>
                    <code>tipoPersona,tipoDocumento,documento,nombre,email,telefono</code>
                    <small>La primera fila es el encabezado. tipoPersona es HUMANA o JURIDICA.</small>
                    <small>El correo electrónico será utilizado para vincular o crear el usuario.</small>
                </div>
                <button type="submit" class="btn btn-primary btn-block" id="process-csv">Subir archivo</button>
            </form>
            <aside class="panel">
                <h3>Archivos subidos</h3>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Archivo</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="csv-importaciones">
                            {{#if importacionesNoDisponible}}
                                <tr data-sin-importaciones>
                                    <td colspan="3" class="muted">No disponible. Intentá nuevamente más tarde.</td>
                                </tr>
                            {{else}}
                                {{#each importaciones}}
                                    <tr data-importacion="{{id}}" {{#if enCurso}}data-en-curso{{/if}}>
                                        <td>{{archivo}}</td>
                                        <td data-fecha>{{fechaTexto}}</td>
                                        <td>
                                            <span class="status-pill {{estadoClase}}" data-estado>{{estadoTexto}}</span>
                                            <small class="muted" data-motivo>{{motivoFallo}}</small>
                                        </td>
                                    </tr>
                                {{else}}
                                    <tr data-sin-importaciones>
                                        <td colspan="3" class="muted">Todavía no subiste ningún archivo.</td>
                                    </tr>
                                {{/each}}
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </aside>
        </div>
    </main>
    {{> templates/partials/footer}}
    {{> templates/partials/scripts}}
