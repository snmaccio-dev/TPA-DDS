{{> templates/partials/head}}
<body data-page="public-donations" data-role="public">
{{> templates/partials/header-publico}}
<main class="public-main">
<div class="page-heading"><div><span class="eyebrow">TRANSPARENCIA</span><h1>Donaciones entregadas</h1><p>Explorá las entregas confirmadas y conocé su impacto.</p></div><a class="btn btn-primary" href="/registro">Sumarme a DonaTrack →</a></div>
{{#if errorDeServicio}}<p class="notice">{{errorDeServicio}}</p>{{/if}}
<div class="public-map-layout">
<div class="map-panel"><div class="panel-head"><div><h3>Mapa de entregas</h3><small>Zona de cobertura</small></div><span class="status-pill success">● Actualizado</span></div><div id="donations-map" class="map-canvas"></div></div>
<aside class="panel donation-list">
        <div class="panel-head"><h3>Entregas recientes</h3><span class="muted">{{entregas.size}} registros</span></div>
{{#each entregas}}
        <article class="donation-item">
                <div class="item-icon">▧</div>
                <div>
                        <b>{{descripcion}}</b>
                        <small>{{cantidadTexto}}{{#if fechaHoraEntrega}} · {{fechaHoraEntrega}}{{/if}}</small>
                        <span class="status-pill success">Entregada</span>
                </div>
        </article>
{{/each}}
{{#unless entregas}}
        <p class="muted">Todavía no hay entregas confirmadas para mostrar.</p>
{{/unless}}
</aside>
</div>
<p class="notice">Las entregas del listado son reales y las publica el microservicio de Logística. Los marcadores del mapa son ilustrativos: las entregas se registran por dirección y todavía no se geocodifican a coordenadas.</p>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
