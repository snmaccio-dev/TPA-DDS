{{> templates/partials/head}}
<body data-page="admin-donors" data-role="admin">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}

<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">ADMINISTRACIÓN</span>
            <h1>Gestión de donantes</h1>
            <p>Consultá las personas donantes y sus datos registrados.</p>
        </div>
    </div>

    <section class="panel">
        <div class="panel-head">
            <h3>Donantes registrados</h3>
            <span class="muted">{{donantes.size}} registrados</span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Donante</th>
                        <th>Tipo</th>
                        <th>Documento</th>
                        <th>Dirección</th>
                        <th>Correo</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each donantes}}
                    <tr>
                        <td>{{nombreDisplay}}</td>
                        <td>{{tipoTexto}}</td>
                        <td>{{documento}}</td>
                        <td>{{direccion}}</td>
                        <td>{{email}}</td>
                    </tr>
                    {{/each}}

                    {{#if donantesNoDisponible}}
                    <tr>
                        <td colspan="5" class="muted">
                            No disponible. Intentá nuevamente más tarde.
                        </td>
                    </tr>
                    {{else}}
                    {{#unless donantes}}
                    <tr>
                        <td colspan="5" class="muted">
                            Todavía no hay donantes registrados.
                        </td>
                    </tr>
                    {{/unless}}
                    {{/if}}
                </tbody>
            </table>
        </div>
    </section>
</main>

{{> templates/partials/footer}}
{{> templates/partials/scripts}}
</body>
