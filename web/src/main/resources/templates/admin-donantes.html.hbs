{{> templates/partials/head}}
<body data-page="admin-donors" data-role="admin">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}

<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">ADMINISTRACIÓN</span>
            <h1>Gestión de donantes</h1>
            <p>Consultá las personas donantes y sus datos registrados.</p>
        </div>
    </div>

    <section class="panel">
        <div class="panel-head">
            <h3>Donantes registrados</h3>
            {{#unless donantesNoDisponible}}
            <span class="muted">
                {{#if busqueda}}{{donantes.total}} encontrados{{else}}{{donantes.total}} donantes registrados{{/if}}
            </span>
            {{/unless}}
        </div>

        <form class="filter-bar" method="get" action="/admin-donantes">
            <label>Buscar
                <input
                    type="search"
                    name="busqueda"
                    value="{{busqueda}}"
                    placeholder="Nombre, razón social, documento o correo">
            </label>
            <button class="btn btn-primary" type="submit">Buscar</button>
            {{#if busqueda}}
            <a class="btn btn-secondary" href="/admin-donantes">Limpiar</a>
            {{/if}}
        </form>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Donante</th>
                        <th>Tipo</th>
                        <th>Documento</th>
                        <th>Dirección</th>
                        <th>Correo</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each donantes.items}}
                    <tr>
                        <td>{{nombreDisplay}}</td>
                        <td>{{tipoTexto}}</td>
                        <td>{{documento}}</td>
                        <td>{{direccion}}</td>
                        <td>{{email}}</td>
                    </tr>
                    {{/each}}

                    {{#if donantesNoDisponible}}
                    <tr>
                        <td colspan="5" class="muted">
                            No disponible. Intentá nuevamente más tarde.
                        </td>
                    </tr>
                    {{else}}
                    {{#if donantes.vacia}}
                    <tr>
                        <td colspan="5" class="muted">
                            No se encontraron donantes.
                        </td>
                    </tr>
                    {{/if}}
                    {{/if}}
                </tbody>
            </table>
        </div>

        {{#unless donantesNoDisponible}}
        <nav class="paginacion" aria-label="Paginación de donantes">
            {{#if donantes.hayAnterior}}
            <a class="btn btn-secondary" href="{{urlAnterior}}">← Anterior</a>
            {{else}}
            <span class="btn btn-secondary is-disabled" aria-disabled="true">← Anterior</span>
            {{/if}}

            <span class="muted">Página {{donantes.pagina}} de {{donantes.totalPaginasTexto}}</span>

            {{#if donantes.haySiguiente}}
            <a class="btn btn-secondary" href="{{urlSiguiente}}">Siguiente →</a>
            {{else}}
            <span class="btn btn-secondary is-disabled" aria-disabled="true">Siguiente →</span>
            {{/if}}
        </nav>
        {{/unless}}
    </section>
</main>

{{> templates/partials/footer}}
{{> templates/partials/scripts}}
</body>
