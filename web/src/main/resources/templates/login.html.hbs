{{> templates/partials/head}}
<body data-page="login" data-role="publico">
{{> templates/partials/header-publico}}
<main class="public-main">
  <section class="panel form-panel">
    <div class="form-title">
      <h2>Iniciar sesión</h2>
      <p>DonaTrack delega la autenticación en su proveedor de identidad.</p>
    </div>

    {{#if cuentaCreada}}
    <p class="notice">Tu cuenta quedó creada. Ingresá con el correo y la contraseña que elegiste.</p>
    {{/if}}
    {{#if errorDeIngreso}}
    <p class="muted">{{errorDeIngreso}}</p>
    {{/if}}

    <a class="btn btn-primary btn-lg btn-block" href="/sesion/ingresar">Ingresar</a>
    <p class="notice">Vas a ser redirigido para validar tus credenciales y volvés acá al terminar.</p>
    <p class="muted">¿No tenés cuenta? <a href="/registro">Creá una</a></p>
  </section>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
