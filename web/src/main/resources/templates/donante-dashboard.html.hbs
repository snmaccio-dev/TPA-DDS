
{{> templates/partials/head}}
<body data-page="donor-dashboard" data-role="donante">
    {{> templates/partials/sidebar}}
    {{> templates/partials/topbar}}

    <main class="app-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">RESUMEN GENERAL</span>
                <h1>Hola, {{usuario.nombre}} &#128075;</h1>
                <p>Este es el resumen de tus aportes y su recorrido.</p>
            </div>

            <a class="btn btn-primary" href="/donaciones/nueva">
                + Realizar una donaci&oacute;n
            </a>
        </div>

        <div class="metric-grid">
            <article class="metric-card">
                <span class="metric-icon green">&#9670;</span>
                <strong>{{#if datosDonacionesDisponibles}}{{totalDonaciones}}{{else}}&#8212;{{/if}}</strong>
                <span>Donaciones realizadas</span>
                <small>Registros de tus donaciones</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon blue">&#9670;</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesEntregadas}}{{else}}&#8212;{{/if}}</strong>
                <span>Entregadas</span>
                <small>Donaciones recibidas por entidades</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon amber">&#9670;</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesEnTransito}}{{else}}&#8212;{{/if}}</strong>
                <span>En tr&aacute;nsito</span>
                <small>Donaciones en traslado</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon lavender">&#9670;</span>
                <strong>{{#if datosDonacionesDisponibles}}{{donacionesPendientes}}{{else}}&#8212;{{/if}}</strong>
                <span>Pendientes</span>
                <small>Donaciones a&uacute;n no entregadas</small>
            </article>
        </div>

        <div class="dashboard-grid">
            <section class="panel">
                <div class="panel-head">
                    <div>
                        <h3>Actividad reciente</h3>
                        <small>Tus &uacute;ltimas donaciones seg&uacute;n n&uacute;mero de registro</small>
                    </div>
                    <a href="/mis-donaciones">Ver todos &#8594;</a>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Donaci&oacute;n</th>
                                <th>Fecha de entrega</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#if datosDonacionesDisponibles}}
                                {{#each donacionesRecientes}}
                                    <tr>
                                        <td>{{descripcion}}</td>
                                        <td>
                                            {{#if fechaHoraEntregaTexto}}
                                                {{fechaHoraEntregaTexto}}
                                            {{else}}
                                                &#8212;
                                            {{/if}}
                                        </td>
                                        <td>
                                            <span class="status-pill {{estadoClase}}">{{estadoTexto}}</span>
                                        </td>
                                    </tr>
                                {{else}}
                                    <tr>
                                        <td colspan="3">Todav&iacute;a no realizaste ninguna donaci&oacute;n.</td>
                                    </tr>
                                {{/each}}
                            {{else}}
                                <tr>
                                    <td colspan="3">No se pudieron cargar tus donaciones.</td>
                                </tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel quick-panel">
                <div class="panel-head">
                    <h3>Accesos r&aacute;pidos</h3>
                </div>

                <a class="quick-link" href="/donaciones/nueva">
                    <span>Realizar una donaci&oacute;n</span>
                    <b>&#8594;</b>
                </a>

                <a class="quick-link" href="/mis-donaciones">
                    <span>Ver mis donaciones</span>
                    <b>&#8594;</b>
                </a>

                <a class="quick-link" href="/entidades">
                    <span>Explorar entidades</span>
                    <b>&#8594;</b>
                </a>

                <a class="quick-link" href="/seguimiento-donante">
                    <span>Seguir una entrega</span>
                    <b>&#8594;</b>
                </a>
            </section>
        </div>
    </main>

    {{> templates/partials/footer}}
    {{> templates/partials/scripts}}
</body>

