{{> templates/partials/head}}
<body data-page="donor-dashboard" data-role="donante">
    {{> templates/partials/sidebar}}
    {{> templates/partials/topbar}}
    <main class="app-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">RESUMEN GENERAL</span>
                <h1>Hola, Martina 👋</h1>
                <p>Este es el resumen de tus aportes y su recorrido.</p>
            </div>
            <span class="date-chip">◷ Noviembre 2026</span>
        </div>
        <div class="metric-grid">
            <article class="metric-card">
                <span class="metric-icon green">▧</span>
                <strong>12</strong>
                <span>Donaciones realizadas</span>
                <small>Datos de demostración</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon blue">▧</span>
                <strong>8</strong>
                <span>Entregadas</span>
                <small>Datos de demostración</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon amber">▧</span>
                <strong>3</strong>
                <span>En tránsito</span>
                <small>Datos de demostración</small>
            </article>
            <article class="metric-card">
                <span class="metric-icon lavender">▧</span>
                <strong>1</strong>
                <span>Pendiente</span>
                <small>Datos de demostración</small>
            </article>
        </div>
        <div class="dashboard-grid">
            <section class="panel">
                <div class="panel-head">
                    <div>
                        <h3>Actividad reciente</h3>
                        <small>Últimos movimientos registrados</small>
                    </div>
                    <a href="/mis-donaciones">Ver todos →</a>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Donación</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Alimentos no perecederos</td>
                                <td>02/11/2026</td>
                                <td>
                                    <span class="status-pill success">Entregada</span>
                                </td>
                            </tr>
                            <tr>
                                <td>Ropa de abrigo</td>
                                <td>31/10/2026</td>
                                <td>
                                    <span class="status-pill info">En tránsito</span>
                                </td>
                            </tr>
                            <tr>
                                <td>Útiles escolares</td>
                                <td>28/10/2026</td>
                                <td>
                                    <span class="status-pill warning">Pendiente</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="panel quick-panel">
                <div class="panel-head">
                    <h3>Accesos rápidos</h3>
                </div>
                <a class="quick-link" href="/mis-donaciones">
                    <span>Ver mis donaciones</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/entidades">
                    <span>Explorar entidades</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/seguimiento-donante">
                    <span>Seguir una entrega</span>
                    <b>→</b>
                </a>
            </section>
        </div>
    </main>
    {{> templates/partials/footer}}
    {{> templates/partials/scripts}}
