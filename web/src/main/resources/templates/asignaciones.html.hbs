
{{> templates/partials/head}}
<body data-page="assignments" data-role="admin">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}

<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">DISTRIBUCIÓN</span>
            <h1>Asignación de donaciones</h1>
            <p>Revisá las propuestas y confirmá la entidad beneficiaria final.</p>
        </div>
        <form method="post" action="/asignaciones/ejecutar">
            <button type="submit" class="btn btn-primary">Ejecutar asignación ahora</button>
        </form>
    </div>

    <section class="panel">
        <div class="panel-head">
            <h3>Propuestas de asignación</h3>
            <span class="muted">{{propuestas.size}} propuestas</span>
        </div>

        {{#each propuestas}}
        <div class="select-donation">
            <div>
                <b>Donación #{{donacionId}} · {{descripcionDonacion}}</b>
                <small>Donante: {{donanteNombre}}</small>
                <small>Generada {{fechaGeneracionTexto}}</small>
            </div>

            {{#if tieneCandidatas}}
            <form class="asignacion-form"
                  method="post"
                  action="/asignaciones/{{donacionId}}">

                <div class="rankings{{#unless huboCoincidencias}} rankings-por-algoritmo{{/unless}}">
                    {{#each rankings}}
                    <fieldset class="ranking">
                        <legend>{{nombre}}</legend>
                        {{#each candidatas}}
                        <label class="opcion-candidata">
                            <input type="radio" name="beneficiariaId" value="{{id}}" required>
                            <span class="opcion-posicion">#{{posicion}}</span>
                            <span class="opcion-datos">
                                <b>{{razonSocial}}</b>
                                <small>CUIT {{cuit}}</small>
                            </span>
                        </label>
                        {{else}}
                        <p class="muted">Este algoritmo no propuso entidades.</p>
                        {{/each}}
                    </fieldset>
                    {{/each}}
                </div>

                <button class="btn btn-primary confirmar-asignacion"
                        type="submit"
                        disabled>
                    Confirmar asignación
                </button>
            </form>
            {{else}}
            <span class="muted">
                No se encontraron beneficiarias con necesidades compatibles
                para esta donación.
            </span>
            {{/if}}
        </div>
        {{/each}}

        {{#if propuestasNoDisponible}}
        <p class="muted">
            No disponible. Intentá nuevamente más tarde.
        </p>
        {{else}}
        {{#unless propuestas}}
        <p class="muted">
            No hay propuestas pendientes de asignación.
        </p>
        {{/unless}}
        {{/if}}
    </section>
</main>

{{> templates/partials/footer}}
{{> templates/partials/scripts}}

<script>
// El boton se habilita recien cuando se elige una de las entidades propuestas.
document.querySelectorAll(".asignacion-form").forEach(form => {
    const boton = form.querySelector(".confirmar-asignacion");
    form.addEventListener("change", () => {
        boton.disabled = !form.querySelector('input[name="beneficiariaId"]:checked');
    });
});
</script>
</body>
</html>
