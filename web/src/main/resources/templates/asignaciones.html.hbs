{{> templates/partials/head}}
<body data-page="assignments" data-role="admin">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">DISTRIBUCIÓN</span>
            <h1>Asignación de donaciones</h1>
            <p>Revisá las propuestas y confirmá la entidad beneficiaria final.</p>
        </div>
        <form method="post" action="/asignaciones/ejecutar">
            <button class="btn btn-primary" type="submit">Ejecutar algoritmo</button>
        </form>
    </div>
    <section class="panel">
        <div class="panel-head">
            <h3>Propuestas de asignación</h3>
            <span class="muted">{{propuestas.size}} propuestas</span>
        </div>
        {{#each propuestas}}
        <div class="select-donation">
            <b>{{descripcionDonacion}}</b>
            <small>Generada {{fechaGeneracionTexto}}</small>
            {{#if tieneCandidatas}}
            <form method="post" action="/asignaciones/{{donacionId}}">
                <label>Entidad beneficiaria
                    <select name="beneficiariaId" required>
                        {{#each candidatas}}
                        <option value="{{id}}">{{razonSocial}}</option>
                        {{/each}}
                    </select>
                </label>
                <button class="btn btn-primary" type="submit">Confirmar asignación</button>
            </form>
            {{else}}
            <span class="muted">El algoritmo no encontró entidades candidatas.</span>
            {{/if}}
        </div>
        {{/each}}
        {{#unless propuestas}}
        <p class="muted">No hay propuestas pendientes. Ejecutá el algoritmo para generarlas.</p>
        {{/unless}}
    </section>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
