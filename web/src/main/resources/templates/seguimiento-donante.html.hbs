{{> templates/partials/head}}
<body data-page="seguimiento-donante" data-role="donante">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
  <div class="page-heading">
    <div>
      <span class="eyebrow">TRAZABILIDAD</span>
      <h1>Seguimiento de entregas</h1>
      <p>Visualizá la ubicación de los vehículos que transportan tus donaciones.</p>
    </div>
    {{#if seguimiento}}<span class="status-pill info">{{seguimiento.total}} en tránsito</span>{{/if}}
  </div>

  {{#if errorDeServicio}}
  <section class="panel">
    <strong>{{errorDeServicio}}</strong>
    <p class="muted">No se pudo cargar el seguimiento. Volvé a intentar en unos minutos.</p>
  </section>
  {{/if}}

  <div class="tracking-layout">
    <section class="panel map-panel">
      <div class="panel-head">
        <div>
          <h3>Mapa de seguimiento</h3>
          <small>Última posición reportada por cada vehículo</small>
        </div>
      </div>
      <div id="seguimiento-map" class="map-canvas tracking-map"></div>
    </section>

    <aside class="panel tracking-details">
      {{#if seguimiento.vacio}}
      <span class="eyebrow">SIN ENTREGAS ACTIVAS</span>
      <p class="muted">No hay rutas en curso con tus donaciones.</p>
      {{else}}
      {{#each seguimiento.rutas}}
      <span class="eyebrow">RUTA {{rutaId}}</span>
      <h3>Camión {{patenteCamion}}</h3>
      <p class="muted">{{estadoTexto}}</p>
      <div class="detail-pair"><span>Avance</span><b>{{avanceTexto}}</b></div>
      <div class="detail-pair"><span>Velocidad</span><b>{{velocidadTexto}}</b></div>
      <div class="detail-pair"><span>Último reporte</span><b>{{ultimoReporteTexto}}</b></div>
      {{/each}}
      {{/if}}
    </aside>
  </div>

  <p class="notice">La posición proviene de los reportes de ubicación registrados en el servicio de Logística.</p>
</main>
{{> templates/partials/footer}}
<script type="application/json" id="puntos-mapa">{{{seguimiento.puntosJson}}}</script>
<script src="/assets/js/mapa-seguimiento.js"></script>
{{> templates/partials/scripts}}
