{{> templates/partials/head}}
<body data-page="beneficiary-dashboard" data-role="beneficiario">
    {{> templates/partials/sidebar}}
    {{> templates/partials/topbar}}
    <main class="app-main">
        <div class="page-heading">
            <div>
                <span class="eyebrow">RESUMEN GENERAL</span>
                <h1>Buen día, equipo 👋</h1>
                <p>Gestioná las necesidades y las entregas de tu organización.</p>
            </div>
            <span class="date-chip">◷ {{fechaActual}}</span>
        </div>

        <div class="metric-grid">
            <article class="metric-card">
                <span class="metric-icon green">▧</span>
                <strong>
                    {{#if datosDonacionesDisponibles}}
                        {{totalDonaciones}}
                    {{else}}
                        —
                    {{/if}}
                </strong>
                <span>Donaciones asignadas</span>
                <small>{{#if datosDonacionesDisponibles}}Total de donaciones{{else}}No disponible{{/if}}</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon blue">▧</span>
                <strong>
                    {{#if datosDonacionesDisponibles}}
                        {{donacionesEnTransito}}
                    {{else}}
                        —
                    {{/if}}
                </strong>
                <span>En tránsito</span>
                <small>{{#if datosDonacionesDisponibles}}Donaciones en traslado{{else}}No disponible{{/if}}</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon amber">▧</span>
                <strong>
                    {{#if datosDonacionesDisponibles}}
                        {{donacionesEntregadas}}
                    {{else}}
                        —
                    {{/if}}
                </strong>
                <span>Recibidas</span>
                <small>{{#if datosDonacionesDisponibles}}Donaciones entregadas{{else}}No disponible{{/if}}</small>
            </article>

            <article class="metric-card">
                <span class="metric-icon lavender">▧</span>
                <strong>
                    {{#if datosNecesidadesDisponibles}}
                        {{totalNecesidades}}
                    {{else}}
                        —
                    {{/if}}
                </strong>
                <span>Necesidades registradas</span>
                <small>{{#if datosNecesidadesDisponibles}}Necesidades de tu entidad{{else}}No disponible{{/if}}</small>
            </article>
        </div>

        <div class="dashboard-grid">
            <section class="panel">
                <div class="panel-head">
                    <div>
                        <h3>Actividad reciente</h3>
                        <small>Últimas donaciones registradas</small>
                    </div>
                    <a href="/donaciones-asignadas">Ver todas →</a>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Donación</th>
                                <th>Fecha de entrega</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#if datosDonacionesDisponibles}}
                                {{#each donacionesRecientes}}
                                    <tr>
                                        <td>{{descripcion}}</td>
                                        <td>
                                            {{#if fechaHoraEntrega}}
                                                {{fechaHoraEntregaTexto}}
                                            {{else}}
                                                —
                                            {{/if}}
                                        </td>
                                        <td>
                                            <span class="status-pill {{estadoClase}}">
                                                {{estadoTexto}}
                                            </span>
                                        </td>
                                    </tr>
                                {{else}}
                                    <tr>
                                        <td colspan="3">Todavía no tenés donaciones asignadas.</td>
                                    </tr>
                                {{/each}}
                            {{else}}
                                <tr>
                                    <td colspan="3">No se pudo cargar la actividad reciente.</td>
                                </tr>
                            {{/if}}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel quick-panel">
                <div class="panel-head">
                    <h3>Accesos rápidos</h3>
                </div>
                <a class="quick-link" href="/necesidades">
                    <span>Registrar necesidad</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/donaciones-asignadas">
                    <span>Ver asignaciones</span>
                    <b>→</b>
                </a>
                <a class="quick-link" href="/confirmar-recepcion">
                    <span>Confirmar recepción</span>
                    <b>→</b>
                </a>
            </section>
        </div>
    </main>
    {{> templates/partials/footer}}
    {{> templates/partials/scripts}}
</body>
