{{> templates/partials/head}}
<body data-page="warehouse" data-role="admin">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
    <div class="page-heading">
        <div>
            <span class="eyebrow">OPERACIÓN LOGÍSTICA</span>
            <h1>Depósito y donaciones</h1>
            <p>Registrá ingresos y mantené actualizado el estado de los bienes.</p>
        </div>
        <button class="btn btn-primary" data-open-modal="stock-modal">＋ Registrar ingreso</button>
    </div>
    <section class="panel">
        <form class="filter-bar" method="get" action="/deposito">
            <label>Estado
                <select name="estado">
                    <option value="">Todos</option>
                    <option value="EN_DEPOSITO">En depósito</option>
                    <option value="ASIGNACION_REALIZADA">Asignada</option>
                    <option value="LISTA_PARA_ENTREGAR">Lista para entregar</option>
                    <option value="EN_TRASLADO">En traslado</option>
                    <option value="ENTREGADA">Entregada</option>
                    <option value="ENTREGA_FALLIDA">Entrega fallida</option>
                    <option value="VENCIDA">Vencida</option>
                </select>
            </label>
            <label>Categoría
                <select name="categoria">
                    <option value="">Todas</option>
                    {{#each categorias}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </label>
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </form>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Donación</th>
                        <th>Cantidad</th>
                        <th>Categoría</th>
                        <th>Subcategoría</th>
                        <th>Estado</th>
                        <th>Fecha entrega</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each donaciones}}
                    <tr>
                        <td>{{descripcion}}</td>
                        <td>{{cantidadTexto}}</td>
                        <td>{{categoria}}</td>
                        <td>{{subcategoria}}</td>
                        <td><span class="status-pill {{estadoClase}}">{{estadoTexto}}</span></td>
                        <td>{{fechaHoraEntregaTexto}}</td>
                        <td>
                            {{#if disponible}}
                            <form method="post" action="/deposito/{{id}}/vencer">
                                <button class="table-action" type="submit">Marcar vencida</button>
                            </form>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                    {{#unless donaciones}}
                    <tr><td colspan="7" class="muted">No hay donaciones registradas.</td></tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </section>
    <div class="modal" id="stock-modal">
        <form class="modal-card" action="/deposito" method="post">
            <button type="button" class="modal-close" data-close-modal>×</button>
            <h2>Registrar donación recibida</h2>
            <label>Donante
                <select name="donanteDocumento" required>
                    {{#each donantes}}
                    <option value="{{documento}}">{{nombreDisplay}} · {{documento}}</option>
                    {{/each}}
                </select>
            </label>
            <label>Descripción general
                <input name="descripcion" required placeholder="Descripción del lote">
            </label>
            <label>Descripción del bien
                <input name="bienDescripcion" required placeholder="Ej. Alimentos en conserva">
            </label>
            <label>Subcategoría
                <select name="subcategoria" required>
                    {{#each subcategorias}}
                    <option value="{{nombre}}">{{etiqueta}}</option>
                    {{/each}}
                </select>
            </label>
            <div class="form-row">
                <label>Cantidad<input type="number" step="0.01" min="0.01" name="cantidad" required></label>
                <label>Condición
                    <select name="condicion">
                        <option value="">Sin especificar</option>
                        <option value="NUEVO">Nuevo</option>
                        <option value="USADO">Usado</option>
                    </select>
                </label>
            </div>
            <label>Fecha de vencimiento<input type="date" name="fechaVencimiento"></label>
            <button class="btn btn-primary btn-block" type="submit">Registrar ingreso</button>
        </form>
    </div>
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
