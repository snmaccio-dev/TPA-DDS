{{> templates/partials/head}}
<body data-page="entities" data-role="donante">
{{> templates/partials/sidebar}}
{{> templates/partials/topbar}}
<main class="app-main">
<div class="page-heading"><div><span class="eyebrow">RED SOLIDARIA</span><h1>Entidades beneficiarias</h1><p>Conocé las organizaciones registradas en la plataforma.</p></div></div>
<div class="entity-grid">
{{#each entidades}}
<article class="panel entity-card">
        <div class="entity-symbol">{{inicial}}</div>
        <span class="status-pill success">Registrada</span>
        <h3>{{razonSocial}}</h3>
        <p>{{direccion}}</p>
        <small>{{tipoTexto}} · {{rubro}}</small>
        <small class="muted">CUIT {{cuit}}{{#if telefono}} · Tel. {{telefono}}{{/if}}</small>
</article>
{{/each}}
</div>
{{#unless entidades}}<p class="notice">Todavía no hay entidades beneficiarias registradas.</p>{{/unless}}
</main>
{{> templates/partials/footer}}
{{> templates/partials/scripts}}
