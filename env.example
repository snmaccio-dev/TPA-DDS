# Copiar como .env en el servidor y completar. El .env NO se commitea.

# IP publica de la VM con guiones + .sslip.io (ej: 140.238.1.2 -> 140-238-1-2.sslip.io)
DOMINIO=140-238-1-2.sslip.io

POSTGRES_PASSWORD=cambiar
KEYCLOAK_ADMIN_PASSWORD=cambiar

# Se regeneran desde la consola de Keycloak despues del primer arranque
# (Clients -> donaciones-backend / logistica-backend -> Credentials -> Regenerate).
DONACIONES_CLIENT_SECRET=pendiente
LOGISTICA_CLIENT_SECRET=pendiente
